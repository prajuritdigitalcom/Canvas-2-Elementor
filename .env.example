# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Multi API Key pool (comma or newline separated) for auto-rotation engine.
GEMINI_API_KEYS="KEY1,KEY2,KEY3"

# ALLOW_SERVER_KEY_FALLBACK: Set to 'true' to allow requests without userKeys to use the server key pool.
# Default is 'false' for public deployments.
ALLOW_SERVER_KEY_FALLBACK="false"

# GEMINI_MODEL_NAME: Override default Gemini model (defaults to 'gemini-3.6-flash').
GEMINI_MODEL_NAME="gemini-3.6-flash"

# GEMINI_OVERALL_SAFETY_TIMEOUT_MS: Safety-net timeout in ms for the ENTIRE convert
# request (all key attempts combined), default 285000 = 4.75 min. This is NOT a
# per-key timeout - each key attempt is allowed to run naturally to completion.
# This only exists to guarantee a clean JSON error response in the rare case a
# call truly hangs forever, instead of letting Vercel force-kill the function
# with an opaque 504. Keep this comfortably below your Vercel Function's
# maxDuration (see vercel.json -> functions.api/convert.ts).
GEMINI_OVERALL_SAFETY_TIMEOUT_MS="285000"

# GEMINI_KEY_COOLDOWN_MS: Cooldown duration in ms for rate-limited API keys before trying them again (default 60000).
GEMINI_KEY_COOLDOWN_MS="60000"

# PASSWORD: Secret password required to unlock the web application.
# Configured in Vercel / Cloud Run environment variables.
PASSWORD="csku2@prajuritdigital.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
