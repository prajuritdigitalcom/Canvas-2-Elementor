# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Multi API Key pool (comma or newline separated) for auto-rotation engine.
GEMINI_API_KEYS="KEY1,KEY2,KEY3"

# ALLOW_SERVER_KEY_FALLBACK: Set to 'true' to allow requests without userKeys to use the server key pool.
# Default is 'false' for public deployments.
ALLOW_SERVER_KEY_FALLBACK="false"

# GEMINI_MODEL_NAME: Override default Gemini model (defaults to 'gemini-3.6-flash').
GEMINI_MODEL_NAME="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
