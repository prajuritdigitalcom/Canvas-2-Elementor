# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Multi API Key pool (comma or newline separated) for auto-rotation engine.
GEMINI_API_KEYS="KEY1,KEY2,KEY3"

# ALLOW_SERVER_KEY_FALLBACK: Set to 'true' to allow requests without userKeys to use the server key pool.
# Default is 'false' for public deployments.
ALLOW_SERVER_KEY_FALLBACK="false"

# GEMINI_MODEL_NAME: Override default Gemini model (defaults to 'gemini-3.6-flash').
GEMINI_MODEL_NAME="gemini-3.6-flash"

# GEMINI_PER_KEY_TIMEOUT_MS: Maximum duration in ms for a single Gemini API call attempt
# before rotating to the next key (default 90000 = 90s). This is a ceiling only -
# the actual timeout used is capped by whatever remains of GEMINI_TOTAL_BUDGET_MS.
GEMINI_PER_KEY_TIMEOUT_MS="90000"

# GEMINI_TOTAL_BUDGET_MS: Maximum duration in ms for the ENTIRE convert request across
# all key attempts combined (default 270000 = 4.5 min). Keep this comfortably below
# your Vercel Function's maxDuration (see vercel.json -> functions.api/convert.ts) so
# a clear JSON error can still be returned before Vercel force-kills the function.
GEMINI_TOTAL_BUDGET_MS="270000"

# GEMINI_KEY_COOLDOWN_MS: Cooldown duration in ms for rate-limited API keys before trying them again (default 60000).
GEMINI_KEY_COOLDOWN_MS="60000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
